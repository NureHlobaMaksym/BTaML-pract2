{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": "dist"
  },
  "include": [
    "hardhat.config.ts",
    "scripts",
    "test",
    "shared",
    "apps/api"
  ],
  "exclude": [
    "node_modules",
    "apps/web"
  ]
}
